    {"source": "/blogs/news/2", "destination": "/hk/blogs/news/2/index.html"},
    {"source": "/blogs/news/2/", "destination": "/hk/blogs/news/2/index.html"},
    {"source": "/", "destination": "/home.html"}
  ],
  "redirects": [
    {"source": "/myesim", "destination": "/products/%E3%83%9E%E3%83%AC%E3%83%BC%E3%82%B7%E3%82%A2", "permanent": true},
    {"source": "/myesim/", "destination": "/products/%E3%83%9E%E3%83%AC%E3%83%BC%E3%82%B7%E3%82%A2", "permanent": true}
  ]
}
